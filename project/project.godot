; Engine configuration file.
; See https://docs.godotengine.org/en/stable/tutorials/editor/project_settings.html

config_version=5

[application]

config/name="Node Runner"
config/description="Learn ML by drawing 2D creatures that evolve to move."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "C#", "Mobile")

[display]

; Design-resolution base with "canvas_items" stretch so HUD/inspector text,
; buttons, and Node2D world positions scale consistently to fill the real
; device resolution instead of rendering at raw device pixels (which made
; the HUD unreadably small on phones with high-density landscape screens).
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation="landscape"

[dotnet]

project/assembly_name="NodeRunner"

[autoload]

RngProvider="*res://src/managers/RngProvider.cs"
SaveManager="*res://src/managers/SaveManager.cs"

[input_devices]

; Touch devices already deliver InputEventScreenTouch/Drag directly (see
; PointerInput.cs); emulating mouse events from the same touch would fire
; press/drag handlers twice per gesture. Desktop development still gets real
; mouse events, so nothing is lost by disabling the emulation.
pointing/emulate_mouse_from_touch=false

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
