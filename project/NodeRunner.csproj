<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>NodeRunner</RootNamespace>
    <!-- Godot generates code we can't control; don't fail the build on its warnings -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- A switch over an enum that misses a named member, so a new part kind fails every complete switch -->
    <WarningsAsErrors>$(WarningsAsErrors);CS8509</WarningsAsErrors>
    <!-- Godot.NET.Sdk manages its own SourceGenerators/GodotSharp versions; opt out of CPM -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\libs\NodeRunner.Domain\NodeRunner.Domain.csproj" />
    <ProjectReference Include="..\libs\NodeRunner.Mechanics\NodeRunner.Mechanics.csproj" />
    <ProjectReference Include="..\libs\NodeRunner.ML\NodeRunner.ML.csproj" />
    <ProjectReference Include="..\libs\NodeRunner.App\NodeRunner.App.csproj" />
    <EmbeddedResource Include="assets/icons/**/*.svg"
                      LogicalName="icons/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
