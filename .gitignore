# Godot 4
.godot/
# Keep *.uid files tracked; Godot uses resource UIDs to keep references stable.

# .NET / C#
bin/
obj/
*.user
*.suo
*.userprefs
mono_crash.*.json

# Test output
TestResults/
[Cc]overage/
coverage.*.xml
*.coverage
*.coveragexml

# Build output: exported APKs land in build/; unanchored so old project/build/ ones stay ignored too
build/
*.apk
*.aab

# Editor and OS files
.DS_Store
.idea/
.vs/
.vscode/
.npp-md-preview.html
*.csproj.old

# Agents' scratch files (AGENTS.md → "Working copy")
/.scratch/

# Machine-local files (AGENTS.md → "Machine-local setup")
.env
/LOCAL_CONFIG.md
/.claude/settings.local.json
/.claude/skills/local_*/
/.claude/rules/local_*
/.claude/hooks/local_*
/.claude/agents/local_*

# Android build template (#914): Godot installs it (docs/RELEASING.md). Only our own files are tracked.
/project/android/*
!/project/android/build/
/project/android/build/*
!/project/android/build/build.gradle
!/project/android/build/src/
/project/android/build/src/*
!/project/android/build/src/monoDebug/
!/project/android/build/src/main/
/project/android/build/src/main/*
!/project/android/build/src/main/java/
/project/android/build/src/main/java/*
!/project/android/build/src/main/java/com/
/project/android/build/src/main/java/com/*
!/project/android/build/src/main/java/com/godot/
/project/android/build/src/main/java/com/godot/*
!/project/android/build/src/main/java/com/godot/game/
/project/android/build/src/main/java/com/godot/game/*
!/project/android/build/src/main/java/com/godot/game/GodotApp.java
